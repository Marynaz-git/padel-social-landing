# Public values only. They end up in client-side JS by design.
# NEVER put the Supabase service_role key here or anywhere in this repo.

# Optional: Supabase → Project Settings → API (registrations also stored in a table)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Formspree form ID (required in production) — registrations are emailed through it
PUBLIC_FORMSPREE_ID=your_form_id

# Optional: production URL used for canonical / Open Graph
PUBLIC_SITE_URL=
