---
/** Thin line icons (1.25px stroke). Decorative by default. */
interface Props {
  name: 'arrow' | 'arrow-down' | 'arrow-up-right' | 'calendar' | 'pin' | 'clock' | 'plus';
  size?: number;
  class?: string;
}
const { name, size = 22, class: cls = 'icon' } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.35"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow' && <path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5" />}
  {name === 'arrow-down' && <path d="M12 4v15M6.5 13.5 12 19l5.5-5.5" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M9 7h8v8" />}
  {
    name === 'calendar' && (
      <>
        <rect x="3.5" y="5" width="17" height="15.5" rx="1.5" />
        <path d="M3.5 9.5h17M8 3v4M16 3v4" />
      </>
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21Z" />
        <circle cx="12" cy="9.8" r="2.3" />
      </>
    )
  }
  {
    name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 7.5V12l3 2" />
      </>
    )
  }
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
</svg>
