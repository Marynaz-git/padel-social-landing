---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import { footer, links, cookieBanner } from '../content/site';
---

<footer class="footer on-dark">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a class="footer__home" href="#top" aria-label={`${footer.wordmark} — home`}>
        <Image src={logo} alt="" width={32} height={32} densities={[1, 2]} class="footer__logo" />
        <span class="serif footer__word">{footer.wordmark}</span>
      </a>
      <p class="label footer__tag">{footer.tagline}</p>
    </div>

    <ul class="footer__links">
      {footer.links.map((l) => (
        <li>
          <a class="link-u" href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>
        </li>
      ))}
    </ul>

    <div class="footer__legal">
      <span>{footer.legal}</span>
      <span class="footer__legal-links">
        <a class="link-u" href={links.privacy.href!}>{links.privacy.label}</a>
        <button type="button" class="link-u footer__cookie" data-cookie-settings>{cookieBanner.settings}</button>
      </span>
    </div>
  </div>
</footer>

<script>
  import { openCookieSettings } from '../lib/consent';
  document.querySelector('[data-cookie-settings]')?.addEventListener('click', openCookieSettings);
</script>

<style>
  .footer { padding-block: var(--s-8) var(--s-6); }
  .footer__inner { display: grid; gap: var(--s-7); }
  .footer__home { display: inline-flex; align-items: center; gap: clamp(0.6rem, 0.45rem + 0.4vw, 0.85rem); }
  .footer__logo { flex: none; width: clamp(28px, 24px + 0.6vw, 32px); height: auto; aspect-ratio: 380 / 384; }
  .footer__word { font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem); line-height: 1; font-weight: 500; }
  .footer__tag { margin-top: 0.6rem; color: var(--gold); }

  .footer__links { display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-7); font-size: 1rem; }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line-dark);
    font-size: 0.82rem;
    color: var(--cream-soft);
  }
  .footer__legal .link-u { font-size: 0.82rem; }
  .footer__legal-links { display: inline-flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); }
  /* a button styled as the existing underline link */
  .footer__cookie { background-color: transparent; border: 0; padding: 0 0 0.3em; color: inherit; font: inherit; cursor: pointer; }

  @media (min-width: 900px) {
    .footer__inner { grid-template-columns: 1fr auto; align-items: center; }
    .footer__legal { grid-column: 1 / -1; }
  }
</style>
