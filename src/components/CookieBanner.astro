---
import { cookieBanner as c, links } from '../content/site';
---

<!--
  Cookie consent. Hidden until the script decides it's needed (no JS → no banner,
  and no pixel either). Non-modal: it doesn't block the page or trap focus.
-->
<section class="cookie" role="region" aria-label={c.label} tabindex="-1" hidden data-cookie>
  <div class="container cookie__inner">
    <p class="cookie__text">
      {c.text}
      <a class="link-u cookie__link" href={links.privacy.href}>{c.privacy}</a>
    </p>
    <div class="cookie__actions">
      <button type="button" class="btn btn--sm cookie__btn cookie__btn--accept" data-consent="granted">{c.accept}</button>
      <button type="button" class="btn btn--sm cookie__btn cookie__btn--outline" data-consent="denied">{c.decline}</button>
    </div>
  </div>
</section>

<script>
  import { getConsent, setConsent, loadPixel, OPEN_EVENT, type Consent } from '../lib/consent';

  const banner = document.querySelector<HTMLElement>('[data-cookie]')!;
  let returnFocus: HTMLElement | null = null;

  const consent = getConsent();
  if (consent === 'granted') loadPixel();
  if (!consent) banner.hidden = false;

  banner.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((b) =>
    b.addEventListener('click', () => {
      setConsent(b.dataset.consent as Consent);
      banner.hidden = true;
      returnFocus?.focus();
      returnFocus = null;
    }),
  );

  // Footer "Cookie settings": show the banner again and move focus into it
  addEventListener(OPEN_EVENT, () => {
    returnFocus = document.activeElement as HTMLElement | null;
    banner.hidden = false;
    banner.focus();
  });
</script>

<style>
  /* full-width bar pinned to the bottom edge, content on the page container */
  .cookie {
    position: fixed;
    z-index: var(--z-menu);
    left: 0;
    right: 0;
    bottom: 0;
    /* dark theme so the bar stands out from the light page */
    background: var(--ink);
    color: var(--ivory);
    border-top: 1px solid var(--line-dark);
    border-radius: var(--radius-0);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .cookie[hidden] { display: none; }
  .cookie:focus-visible { outline: 2px solid var(--gold); outline-offset: -3px; }
  .cookie__inner {
    display: grid;
    gap: var(--s-3);
    padding-block: var(--s-4);
  }
  .cookie__text { font-size: 0.9rem; line-height: 1.45; color: var(--ivory); }
  .cookie__link { margin-left: 0.35em; font-size: inherit; padding-bottom: 0.1em; color: var(--ivory); }
  .cookie__link:hover { color: var(--cream); }
  .cookie__link:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }

  /* Accept = light filled pill (primary); Decline = light outline pill, same size/font/padding */
  .cookie__actions { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); }
  .cookie__btn { width: 100%; }
  .cookie__btn--accept { background: var(--ivory); color: var(--ink); }
  .cookie__btn--accept:hover { background: var(--cream); }
  .cookie__btn--outline {
    background: transparent;
    color: var(--ivory);
    box-shadow: inset 0 0 0 1px var(--ivory); /* border without changing the button's size */
  }
  .cookie__btn--outline:hover { background: rgb(var(--ivory-rgb) / 0.1); }
  .cookie__btn:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }

  @media (min-width: 768px) {
    .cookie__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      column-gap: var(--s-7);
      padding-block: var(--s-4);
    }
    .cookie__text { font-size: 0.95rem; }
    .cookie__actions { grid-template-columns: repeat(2, 8rem); }
  }
</style>
