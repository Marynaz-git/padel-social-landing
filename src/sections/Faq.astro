---
import { faq } from '../content/site';
import Icon from '../components/Icon.astro';
---

<section class="faq section" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <h2 id="faq-title" class="h2 faq__title">{faq.title}</h2>

    <div class="faq__list">
      {faq.items.map((it) => (
        <details class="faq__item">
          <summary>
            <span class="faq__q serif">{it.q}</span>
            <span class="faq__icon" aria-hidden="true"><Icon name="plus" size={20} /></span>
          </summary>
          <div class="faq__a"><p>{it.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { background: var(--ivory); }
  .faq__grid { display: grid; gap: var(--s-6); }
  .faq__title { font-size: clamp(3rem, 1.6rem + 5vw, 7rem); }

  .faq__item { border-bottom: 1px solid var(--ivory-line); }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding-block: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__q {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.9rem);
    line-height: 1.2;
    font-weight: 450;
    transition: color var(--dur-fast);
  }
  .faq__item summary:hover .faq__q { color: var(--amber-ink); }
  .faq__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--amber-ink);
    transition: transform var(--dur-med) var(--ease-out);
  }
  .faq__item[open] .faq__icon { transform: rotate(45deg); }
  .faq__a { padding: 0 3.5rem 1.75rem 0; color: var(--ink-soft); max-width: 42rem; }

  @media (min-width: 900px) {
    .faq__grid { grid-template-columns: repeat(12, 1fr); column-gap: var(--col-gap); }
    .faq__title { grid-column: 1 / 5; }
    .faq__list { grid-column: 5 / 13; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq__icon { transition: none; }
  }
</style>
