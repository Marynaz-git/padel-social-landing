---
import { tickets, links } from '../content/site';
import Icon from '../components/Icon.astro';
---

<section class="tix section" id="tickets" aria-labelledby="tix-title">
  <div class="container">
    <header class="tix__head">
      <div class="tix__intro">
        <p class="label label--accent">{tickets.label}</p>
        <h2 id="tix-title" class="h2 lines tix__title">
          <span>{tickets.headline.line1}</span>
          <span><span class="accent">{tickets.headline.accent}</span>{tickets.headline.rest}</span>
        </h2>
        <p class="lead tix__lead">{tickets.intro[0]}<br />{tickets.intro[1]}</p>
      </div>
      <ul class="label tix__aside" aria-hidden="true">
        {tickets.aside.map((w) => <li>{w}</li>)}
      </ul>
    </header>

    <ul class="tix__cards">
      {tickets.cards.map((c) => (
        <li class="tix__card">
          <div class="tix__top">
            <h3 class="h3 tix__name">{c.title.map((l) => <span>{l}</span>)}</h3>
            <p class="h3 tix__price">{c.price}</p>
          </div>
          <p class="tix__text">{c.text}</p>

          <div class="tix__block">
            <p class="label tix__sub"><span>{c.sub.label}</span><span>{c.sub.time}</span></p>
            <ul class="tix__items">
              {c.items.map((it) => (
                <li>
                  <span class="tix__badge" aria-hidden="true"><Icon name={it.icon} size={22} /></span>
                  <span>{it.text}</span>
                </li>
              ))}
            </ul>
          </div>

          {c.plus && (
            <div class="tix__block">
              <p class="label tix__sub"><span>{c.plus.label}</span><span>{c.plus.time}</span></p>
            </div>
          )}

          <a class="btn btn--dark btn--lg tix__btn" href={links.register} data-ticket={c.participation}>
            <span>{c.cta}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Ticket buttons: preselect the matching Participation option, scroll to the
  // form and focus its first field. Without JS they are plain #register links.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLAnchorElement>('[data-ticket]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const form = document.querySelector<HTMLFormElement>('[data-reg-form]');
      const target = document.querySelector<HTMLElement>(a.hash);
      const radio = form?.querySelector<HTMLInputElement>(`input[name="participation"][value="${a.dataset.ticket}"]`);
      if (!form || !target || !radio) return; // fall back to the plain link
      e.preventDefault();
      radio.checked = true;
      radio.dispatchEvent(new Event('change', { bubbles: true })); // form shows/hides Playing level
      target.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'start' });
      history.pushState(null, '', a.hash);
      form.querySelector<HTMLElement>('input, select, textarea')?.focus({ preventScroll: true });
    });
  });
</script>

<style>
  .tix { background: var(--ivory); }

  /* ---------- Header ---------- */
  .tix__head { display: grid; gap: var(--s-6); }
  .tix__title { margin-top: var(--s-5); font-size: clamp(2.3rem, 0.9rem + 5.8vw, 7.5rem); }
  .tix__title > span { white-space: normal; }
  .tix__lead { margin-top: var(--s-5); max-width: 28em; color: var(--ink-soft); } /* same colour as the Location text */
  .tix__aside { display: none; }

  /* ---------- Cards ---------- */
  .tix__cards {
    display: grid;
    gap: var(--s-5);
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
  }
  .tix__card {
    display: flex;
    flex-direction: column;
    padding: var(--s-6) var(--s-5);
    border: 1px solid var(--ivory-line);
    background: var(--ivory); /* same fill as the registration panel (.reg) */
    container-type: inline-size;
  }
  .tix__card > * { min-width: 0; }

  .tix__top { display: grid; gap: var(--s-3); }
  .tix__name > span { display: block; }
  .tix__price { color: var(--amber-ink); }
  /* wide enough: price moves to the right of the title */
  @container (min-width: 30rem) {
    /* price top-aligned with the first line of the title (same size, same line box) */
    .tix__top { grid-template-columns: 1fr auto; column-gap: var(--s-5); align-items: start; }
    .tix__price { text-align: right; }
  }

  .tix__text { margin-top: var(--s-4); max-width: 30em; color: var(--ink-soft); }

  .tix__block { margin-top: var(--s-5); padding-top: var(--s-5); border-top: 1px solid var(--ivory-line); }
  .tix__sub { display: flex; flex-wrap: wrap; gap: 0.3rem var(--s-4); }

  .tix__items { display: grid; gap: var(--s-3); margin-top: var(--s-4); }
  .tix__items li { display: flex; align-items: center; gap: var(--s-4); color: var(--ink-soft); }
  .tix__badge {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--amber) 14%, var(--ivory));
    color: var(--amber-ink);
  }
  .tix__badge :global(svg) { width: 1.35rem; height: 1.35rem; }

  /* same button as the form submit (.btn .btn--dark .btn--lg), full width like .reg__submit */
  .tix__btn { width: 100%; margin-top: auto; }
  /* the long label may wrap on narrow cards instead of overflowing */
  .tix__btn > span { white-space: normal; text-align: center; }
  .tix__card > .tix__block:last-of-type { margin-bottom: var(--s-6); }

  /* ---------- Desktop ---------- */
  @media (min-width: 1024px) {
    .tix__head { grid-template-columns: 1fr auto; align-items: start; column-gap: var(--s-7); }
    .tix__aside {
      display: grid;
      gap: var(--s-3);
      margin-top: 2.5rem;
      padding: var(--s-2) 0 var(--s-2) var(--s-6);
      border-left: 1px solid var(--amber);
    }
    .tix__cards { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; gap: var(--col-gap); }
    .tix__card { padding: var(--s-7) var(--s-6); }
  }
</style>
