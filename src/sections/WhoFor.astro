---
import { whoFor } from '../content/site';
---

<section class="who section" id="who" aria-labelledby="who-title">
  <div class="container">
    <p class="label label--accent who__label">{whoFor.label}</p>

    <div class="who__head">
      <h2 id="who-title" class="h2 lines who__title">
        {whoFor.headline.map((l) => <span>{l}</span>)}
      </h2>
      <p class="serif who__small">{whoFor.small}</p>
    </div>

    <ul class="ruled-cols who__list">
      {whoFor.statements.map((s, i) => (
        <li>
          <span class="ruled-cols__mark" aria-hidden="true">{i + 1}</span>
          <p>{s.map((line) => <span>{line}</span>)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .who { background: var(--ivory); }
  .who__label { margin-bottom: var(--s-6); }
  .who__head { display: grid; gap: var(--s-5); }
  .who__title { font-size: clamp(2.3rem, 0.9rem + 5.8vw, 7.5rem); }
  .who__title > span { white-space: normal; }
  .who__small {
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.4rem);
    font-style: italic;
    color: var(--amber-ink);
  }

  .who__list { margin-top: clamp(3rem, 2rem + 5vw, 7rem); }
  .who__list p {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.9rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .who__list p span { display: block; }

  @media (min-width: 900px) {
    .who__title > span { white-space: nowrap; }
    .who__head {
      grid-template-columns: 1fr auto;
      align-items: end;
      column-gap: var(--s-7);
    }
    .who__small { padding-bottom: 0.6em; }
  }
</style>
