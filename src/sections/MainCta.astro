---
import { mainCta, registration as r, event, links } from '../content/site';
import { PINNED_COUNTRIES, OTHER_COUNTRIES, COUNTRY_BY_ISO, DEFAULT_ISO } from '../content/countries';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
const f = r.fields;
const defaultCountry = COUNTRY_BY_ISO[DEFAULT_ISO];
---

<section class="cta on-accent" id="join" aria-labelledby="cta-title">
  <div class="container cta__grid">
    <div class="cta__lead">
      <p class="label cta__small">{mainCta.small}</p>
      <h2 id="cta-title" class="h2 lines cta__title">
        {mainCta.headline.map((l) => <span>{l}</span>)}
      </h2>
      <div class="cta__macro">
        <Photo slot="ctaMacro" sizes="(min-width: 1024px) 18vw, 40vw" decorative />
      </div>
    </div>

    <div class="reg" id="register" tabindex="-1">
      <div class="reg__head">
        <h3 class="caps reg__title">{r.title}</h3>
        <p class="reg__intro">{r.intro}</p>
      </div>

      <form class="reg__form" method="post" novalidate data-reg-form>
        <div class="field">
          <label for="f-name">{f.fullName}</label>
          <input id="f-name" name="full_name" type="text" autocomplete="name" required aria-describedby="e-name" />
          <p class="field__err" id="e-name"></p>
        </div>

        <fieldset class="field phone" aria-describedby="e-country e-phone">
          <legend>{f.phone}</legend>
          <div class="phone__row">
            <div class="phone__cc">
              <label class="phone__sublabel" for="f-cc">{f.phoneCountry}</label>
              <div class="select phone__select">
                <span class="phone__display" aria-hidden="true" data-cc-display>
                  <span class="flag">{defaultCountry.flag}</span> +{defaultCountry.dial}
                </span>
                <select id="f-cc" name="phone_country" required autocomplete="tel-country-code" aria-describedby="e-country">
                  <optgroup label={f.phonePinnedGroup}>
                    {PINNED_COUNTRIES.map((c) => (
                      <option value={c.iso} data-flag={c.flag} data-dial={c.dial} selected={c.iso === DEFAULT_ISO}>{c.flag} {c.name} (+{c.dial})</option>
                    ))}
                  </optgroup>
                  <optgroup label={f.phoneAllGroup}>
                    {OTHER_COUNTRIES.map((c) => (
                      <option value={c.iso} data-flag={c.flag} data-dial={c.dial}>{c.flag} {c.name} (+{c.dial})</option>
                    ))}
                  </optgroup>
                </select>
                <svg class="select__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg>
              </div>
            </div>
            <div class="phone__num">
              <label class="phone__sublabel" for="f-phone">{f.phoneNumber}</label>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel-national" inputmode="tel" required aria-describedby="e-phone" placeholder="912 345 678" />
            </div>
          </div>
          <p class="field__err" id="e-country"></p>
          <p class="field__err" id="e-phone"></p>
        </fieldset>

        <fieldset class="field choice" aria-describedby="e-contact">
          <legend>{f.contactVia}</legend>
          <div class="choice__opts">
            {f.contactOptions.map((o) => (
              <label class="opt-box">
                <input type="radio" name="contact_via" value={o.value} required />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
          <p class="field__err" id="e-contact"></p>
        </fieldset>

        <fieldset class="field choice" aria-describedby="e-part">
          <legend>{f.participation}</legend>
          <div class="choice__opts choice__opts--price">
            {f.participationOptions.map((o, i) => (
              <label class="opt-box">
                <input type="radio" name="participation" value={o.value} required checked={i === 0} />
                <span><span class="opt-box__label">{o.label}</span><span class="opt-box__price">{o.price}</span></span>
              </label>
            ))}
          </div>
          <p class="field__err" id="e-part"></p>
        </fieldset>

        <div class="field" data-level>
          <label for="f-level">{f.level}</label>
          <div class="select">
            <select id="f-level" name="level" aria-describedby="h-level e-level">
              <option value="" disabled selected>{f.levelPlaceholder}</option>
              {f.levelGroups.map((g) => (
                <optgroup label={g.label}>
                  {g.options.map((o) => <option value={o.value}>{o.label}</option>)}
                </optgroup>
              ))}
            </select>
            <svg class="select__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg>
          </div>
          <p class="field__help" id="h-level">{f.levelHelp}</p>
          <p class="field__err" id="e-level"></p>
        </div>

        <!-- honeypot: hidden from people and assistive tech -->
        <div class="hp" aria-hidden="true">
          <label for="f-company">Company</label>
          <input id="f-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field consent">
          <label class="consent__label">
            <input type="checkbox" name="consent" required aria-describedby="e-consent" />
            <span class="consent__box" aria-hidden="true"></span>
            <span>
              {f.consent}
              <a href={links.privacy.href!} target="_blank" rel="noopener">{links.privacy.label}</a>.
            </span>
          </label>
          <p class="field__err" id="e-consent"></p>
        </div>

        <div class="reg__alert" role="alert" hidden data-alert>
          <p class="reg__alert-title" data-alert-title></p>
          <p data-alert-text></p>
        </div>

        <button class="btn btn--dark btn--lg reg__submit" type="submit" data-submit>
          <span data-submit-label>{r.submit}</span>
          <Icon name="arrow" class="arrow" />
        </button>

        <p class="sr-only" aria-live="polite" data-status></p>
      </form>

      {(['success', 'duplicate'] as const).map((k) => (
        <div class="reg__result" hidden tabindex="-1" data-result={k}>
          <p class="caps reg__result-title">{r[k].title}</p>
          <p class="reg__result-text" data-result-text data-template={r[k].text}>{r[k].text.replace('{app}', 'Telegram or WhatsApp')}</p>
          <dl class="reg__facts">
            <div><dt>Date</dt><dd>{event.dayLabel}, {event.dateLabel}</dd></div>
            <div><dt>Venue</dt><dd>{event.venue}, {event.city}</dd></div>
            {event.schedule.map((s) => (
              <div><dt>{s.start}–{s.end}</dt><dd>{s.label}</dd></div>
            ))}
          </dl>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { validate, submitRegistration, contactLabel, type RegistrationData, type FieldKey, type Participation } from '../lib/registration';
  import { registration as r } from '../content/site';
  import { trackLead } from '../lib/pixel';
  import type { FppLevel, ContactVia } from '../content/site';

  const form = document.querySelector<HTMLFormElement>('[data-reg-form]');
  if (form) {
    const reg = form.closest<HTMLElement>('.reg')!;
    const level = form.querySelector<HTMLElement>('[data-level]')!;
    const levelSelect = level.querySelector<HTMLSelectElement>('select')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const alertBox = form.querySelector<HTMLElement>('[data-alert]')!;

    // field → [focus target, inputs that get aria-invalid, error element]
    const fields: Record<FieldKey, { focus: HTMLElement; inputs: HTMLElement[]; err: HTMLElement }> = {
      fullName: { focus: form.querySelector('#f-name')!, inputs: [form.querySelector('#f-name')!], err: form.querySelector('#e-name')! },
      country: { focus: form.querySelector('#f-cc')!, inputs: [form.querySelector('#f-cc')!], err: form.querySelector('#e-country')! },
      phone: { focus: form.querySelector('#f-phone')!, inputs: [form.querySelector('#f-phone')!], err: form.querySelector('#e-phone')! },
      contactVia: {
        focus: form.querySelector('input[name="contact_via"]')!,
        inputs: [...form.querySelectorAll<HTMLElement>('input[name="contact_via"]')],
        err: form.querySelector('#e-contact')!,
      },
      participation: {
        focus: form.querySelector('input[name="participation"]')!,
        inputs: [...form.querySelectorAll<HTMLElement>('input[name="participation"]')],
        err: form.querySelector('#e-part')!,
      },
      level: { focus: levelSelect, inputs: [levelSelect], err: form.querySelector('#e-level')! },
      consent: {
        focus: form.querySelector('input[name="consent"]')!,
        inputs: [form.querySelector('input[name="consent"]')!],
        err: form.querySelector('#e-consent')!,
      },
    };
    const order: FieldKey[] = ['fullName', 'country', 'phone', 'contactVia', 'participation', 'level', 'consent'];
    const touched = new Set<FieldKey>();

    const read = (): RegistrationData => {
      const fd = new FormData(form);
      const participation = String(fd.get('participation') ?? '') as Participation;
      return {
        fullName: String(fd.get('full_name') ?? ''),
        phoneCountry: String(fd.get('phone_country') ?? ''),
        phoneNumber: String(fd.get('phone') ?? ''),
        contactVia: String(fd.get('contact_via') ?? '') as ContactVia | '',
        participation,
        level: participation === 'tournament_after' ? ((fd.get('level') as FppLevel | null) || null) : null,
        consent: fd.get('consent') === 'on',
        gotcha: String(fd.get('company') ?? ''),
      };
    };

    const show = (errors: Partial<Record<FieldKey, string>>, only?: Set<FieldKey>) => {
      for (const k of order) {
        if (only && !only.has(k)) continue;
        const msg = errors[k] ?? '';
        fields[k].err.textContent = msg;
        fields[k].inputs.forEach((el) => (msg ? el.setAttribute('aria-invalid', 'true') : el.removeAttribute('aria-invalid')));
      }
    };

    const sync = () => {
      const playing = read().participation === 'tournament_after';
      level.hidden = !playing;
      levelSelect.required = playing; // required only for Tournament + After Padel
      if (!playing) show({}, new Set<FieldKey>(['level']));
    };
    form.addEventListener('change', sync);
    sync();

    // closed state of the country select shows "🇵🇹 +351"
    const cc = form.querySelector<HTMLSelectElement>('#f-cc')!;
    const ccDisplay = form.querySelector<HTMLElement>('[data-cc-display]')!;
    const syncCountry = () => {
      const opt = cc.selectedOptions[0];
      ccDisplay.innerHTML = '';
      if (!opt || !opt.value) return;
      const flag = document.createElement('span');
      flag.className = 'flag';
      flag.textContent = opt.dataset.flag ?? '';
      ccDisplay.append(flag, ` +${opt.dataset.dial ?? ''}`);
    };
    cc.addEventListener('change', syncCountry);
    syncCountry();

    // inline validation on blur (only fields the person has visited)
    form.addEventListener('focusout', (e) => {
      const k = order.find((key) => fields[key].inputs.includes(e.target as HTMLElement));
      if (!k) return;
      touched.add(k);
      show(validate(read()), touched);
    });

    const setSubmitting = (on: boolean) => {
      submitBtn.disabled = on;
      submitBtn.setAttribute('aria-busy', String(on));
      submitLabel.textContent = on ? r.submitting : r.submit;
    };

    const showAlert = (title: string, text: string) => {
      alertBox.querySelector('[data-alert-title]')!.textContent = title;
      alertBox.querySelector('[data-alert-text]')!.textContent = text;
      alertBox.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.hidden = true;
      const data = read();
      const errors = validate(data);
      order.forEach((k) => touched.add(k));
      show(errors);
      const first = order.find((k) => errors[k]);
      if (first) {
        status.textContent = r.checkFields;
        fields[first].focus.focus();
        return;
      }

      setSubmitting(true);
      status.textContent = r.submitting;
      const result = await submitRegistration(data);
      setSubmitting(false);

      // Meta Pixel Lead: new successful registrations only
      if (result.status === 'success') trackLead(data.participation);
      if (result.status === 'success' || result.status === 'duplicate') {
        const panel = reg.querySelector<HTMLElement>(`[data-result="${result.status}"]`)!;
        const text = panel.querySelector<HTMLElement>('[data-result-text]');
        if (text) text.textContent = text.dataset.template!.replace('{app}', contactLabel(data.contactVia));
        form.hidden = true;
        panel.hidden = false;
        status.textContent = '';
        panel.focus();
        return;
      }

      // error: keep everything the person typed, let them retry
      const copy = result.reason === 'unavailable' ? r.unavailable : r.error;
      showAlert(copy.title, copy.text);
      status.textContent = `${copy.title} ${copy.text}`;
      submitBtn.focus();
    });
  }
</script>

<style>
  .cta {
    background: var(--grad-section);
    color: var(--ink);
    padding-block: var(--section-y);
    position: relative;
    overflow: hidden;
  }
  /* soft tonal depth, not a flat SaaS gradient */
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 80% at 0% 100%, rgb(214 110 20 / 0.35), transparent 70%),
      radial-gradient(40% 60% at 100% 0%, rgb(255 214 120 / 0.35), transparent 70%);
    pointer-events: none;
  }
  .cta__grid { position: relative; display: grid; gap: var(--s-8); }
  .cta__grid > * { min-width: 0; }
  /* the headline is sized against its own column: "ON COURT?" ≈ 5.55em wide */
  .cta__lead { container-type: inline-size; }

  .cta__small { letter-spacing: 0.32em; }
  .cta__title {
    margin-top: var(--s-5);
    font-size: min(clamp(3.6rem, 1.4rem + 9vw, 10.5rem), calc(100cqi / 5.75));
    line-height: 0.86;
  }
  .cta__macro { width: 42%; max-width: 13rem; margin-top: var(--s-7); }

  /* ---- Registration panel ---- */
  .reg {
    background: var(--ivory);
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    outline: none;
  }
  .reg__head { padding-bottom: var(--s-5); margin-bottom: var(--s-5); border-bottom: 1px solid var(--ivory-line); }
  .reg__title { font-size: 1.05rem; letter-spacing: 0.16em; }
  .reg__intro { margin-top: 0.4rem; color: var(--ink-soft); font-size: 0.95rem; }

  .reg__form { display: grid; gap: 1.35rem; }

  .field { display: grid; gap: 0.35rem; border: 0; padding: 0; margin: 0; min-width: 0; }
  .field[hidden] { display: none; }
  .field > label:not(.consent__label), .field legend {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0;
  }
  .field legend { margin-bottom: 0.6rem; }

  .field input[type='text'],
  .field input[type='tel'] {
    width: 100%;
    height: 3rem;
    padding: 0 0.1rem;
    border: 0;
    border-bottom: 1px solid var(--field-line);
    border-radius: 0;
    background: transparent;
    font-size: 1.05rem;
    transition: border-color var(--dur-fast);
  }
  .field input:hover { border-bottom-color: var(--ink); }
  .field input:focus-visible { outline: none; border-bottom: 1.5px solid var(--amber); box-shadow: 0 1px 0 0 var(--amber); }
  .field input[aria-invalid='true'] { border-bottom-color: #a4260e; }
  .field__err { font-size: 0.82rem; color: #a4260e; min-height: 0; }
  .field__err:empty { display: none; }

  /* equal columns, equal heights */
  .choice__opts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: stretch; gap: 0.5rem; }
  .opt-box__label, .opt-box__price { display: block; }
  .opt-box__price { margin-top: 0.2rem; font-weight: 600; }

  /* phone: country code + national number */
  .phone__row { display: grid; grid-template-columns: minmax(7.25rem, 8.5rem) minmax(0, 1fr); gap: 0.75rem; align-items: end; }
  .phone__sublabel { display: block; font-size: 0.72rem; color: var(--ink-soft); margin-bottom: 0.3rem; }
  /* the native select stays on top (invisible) for mouse, keyboard and screen readers;
     the box underneath shows the closed state as "🇵🇹 +351" */
  .select.phone__select {
    height: 3rem;
    border: 1px solid var(--field-box);
    transition: border-color var(--dur-fast);
  }
  .select.phone__select:hover { border-color: var(--ink); }
  .select.phone__select:has(select:focus-visible) { outline: 2px solid var(--amber); outline-offset: 2px; border-color: var(--ink); }
  .select.phone__select:has(select[aria-invalid='true']) { border-color: #a4260e; }
  .select.phone__select > select {
    position: absolute;
    inset: 0;
    height: 100%;
    opacity: 0;
    border: 0;
  }
  .select.phone__select > select:focus-visible { outline: none; }
  .phone__select select, .flag { font-family: 'Twemoji Country Flags', var(--font-sans); }
  .phone__display {
    position: absolute;
    inset: 0 2.2rem 0 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1rem;
    pointer-events: none;
    white-space: nowrap;
  }
  .phone__display .flag { font-size: 1.15rem; line-height: 1; }
  .phone__num input { width: 100%; }
  /* level select: flat, thin border, custom chevron */
  .select { position: relative; }
  .select select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    height: 3rem;
    padding: 0 2.5rem 0 0.9rem;
    border: 1px solid var(--field-box);
    border-radius: 0;
    background: transparent;
    font-size: 1rem;
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--dur-fast);
  }
  .select select:hover { border-color: var(--ink); }
  .select select:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; border-color: var(--ink); }
  .select select:invalid { color: var(--ink-soft); }
  .select select option, .select select optgroup { color: var(--ink); }
  .select select[aria-invalid='true'] { border-color: #a4260e; }
  .select__chevron { position: absolute; right: 0.9rem; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--ink); }
  .field__help { font-size: 0.8rem; color: var(--ink-soft); }
  .opt-box { position: relative; display: flex; cursor: pointer; }
  .opt-box input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .opt-box > span {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--field-box);
    font-size: 0.9rem;
    text-align: center;
    line-height: 1.2;
    transition: background-color var(--dur-fast), border-color var(--dur-fast), color var(--dur-fast);
  }
  .opt-box:hover > span { border-color: var(--ink); }
  .opt-box input:checked + span { background: var(--ink); border-color: var(--ink); color: var(--cream); }
  .opt-box input:focus-visible + span { outline: 2px solid var(--amber); outline-offset: 2px; }

  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .consent__label { display: flex; gap: 0.8rem; align-items: flex-start; font-size: 0.85rem; line-height: 1.45; color: var(--ink-soft); cursor: pointer; position: relative; }
  .consent__label input { position: absolute; opacity: 0; width: 1.15rem; height: 1.15rem; margin: 0.1rem 0 0; }
  .consent__box {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.1rem;
    border: 1px solid var(--field-check);
    display: grid;
    place-items: center;
  }
  .consent__label input:checked + .consent__box { background: var(--ink); border-color: var(--ink); }
  .consent__label input:checked + .consent__box::after {
    content: '';
    width: 0.3rem;
    height: 0.6rem;
    border: solid var(--cream);
    border-width: 0 1.5px 1.5px 0;
    transform: translateY(-1px) rotate(45deg);
  }
  .consent__label input:focus-visible + .consent__box { outline: 2px solid var(--amber); outline-offset: 2px; }
  .consent__label input[aria-invalid='true'] + .consent__box { border-color: #a4260e; }
  .consent a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }

  .reg__submit { width: 100%; margin-top: 0.25rem; }
  .reg__alert {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid #a4260e;
    background: rgb(164 38 14 / 0.05);
    color: #7d1d0b;
    font-size: 0.92rem;
  }
  .reg__alert[hidden] { display: none; }
  .reg__form[hidden] { display: none; }
  .reg__alert-title { font-weight: 600; }
  .reg__submit[disabled] { cursor: progress; }

  .reg__result { display: grid; gap: var(--s-4); outline: none; }
  .reg__result[hidden] { display: none; }
  .reg__result:focus-visible { outline: 2px solid var(--amber); outline-offset: 6px; }
  .reg__result-title { font-size: 1.4rem; letter-spacing: 0.08em; }
  .reg__result-text { color: var(--ink-soft); }
  .reg__facts { display: grid; gap: 0.5rem; margin: var(--s-3) 0 0; padding-top: var(--s-4); border-top: 1px solid var(--ivory-line); font-size: 0.95rem; }
  .reg__facts div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.75rem; }
  .reg__facts dt { color: var(--ink-soft); }
  .reg__facts dd { margin: 0; font-weight: 500; }

  @media (min-width: 560px) {
  }
  @media (min-width: 1024px) {
    .cta__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: start;
    }
    .cta__lead { grid-column: 1 / 7; position: sticky; top: 7rem; }
    .reg { grid-column: 7 / 13; }
  }
  @media (min-width: 1280px) {
    .reg { grid-column: 8 / 13; }
  }
</style>
