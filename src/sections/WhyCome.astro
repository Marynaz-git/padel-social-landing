---
import { whyCome } from '../content/site';
---

<section class="why section" id="why" aria-labelledby="why-title">
  <div class="container">
    <h2 id="why-title" class="label label--accent why__label">{whyCome.label}</h2>

    <!-- same ruled 3-column layout as Who It's For (.ruled-cols in global.css) -->
    <ol class="ruled-cols">
      {whyCome.columns.map((c) => (
        <li>
          <span class="ruled-cols__mark" aria-hidden="true">{c.num}</span>
          <div class="why__text">
            <h3 class="caps why__title">{c.title}</h3>
            <p class="why__quote">
              {c.text.map((t) => <span>{t} </span>)}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .why { background: var(--ivory); }
  .why__label { margin-bottom: clamp(2.5rem, 1.5rem + 4vw, 5rem); }

  .why__text { display: grid; row-gap: 0.75rem; }
  /* titles serif caps; descriptions in the UI sans (kept from the last fix) */
  .why__title { font-size: 0.95rem; letter-spacing: 0.16em; padding-top: 0.2rem; }
  .why__quote {
    font-family: var(--font-sans);
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--ink-soft);
    max-width: 24em;
  }
</style>
