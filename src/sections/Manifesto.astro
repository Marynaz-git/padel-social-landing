---
import { manifesto } from '../content/site';
---

<section class="manifesto section" id="manifesto" aria-labelledby="manifesto-title">
  <div class="container manifesto__grid">
    <h2 id="manifesto-title" class="h2 lines manifesto__title">
      {manifesto.headline.lines.map((l) => <span>{l}</span>)}
      <span>{manifesto.headline.accentLine[0]}<span class="accent">{manifesto.headline.accentLine[1]}</span></span>
    </h2>

    <div class="manifesto__body">
      <span class="manifesto__rule" aria-hidden="true"></span>
      <p class="lead">{manifesto.body}</p>
    </div>

    <p class="manifesto__statement serif lines">
      <span>{manifesto.statement[0]}</span>
      <span class="manifesto__indent">{manifesto.statement[1]}</span>
    </p>
  </div>
</section>

<style>
  .manifesto { background: var(--ivory); }
  .manifesto__grid {
    display: grid;
    gap: var(--s-6);
  }
  .manifesto__title { font-size: clamp(3.4rem, 1.4rem + 8vw, 9rem); line-height: 0.88; }

  .manifesto__body { max-width: 30rem; }
  .manifesto__rule { display: block; width: 3.5rem; height: 1px; background: var(--amber); margin-bottom: var(--s-5); }

  .manifesto__statement {
    margin-top: var(--s-7);
    padding-top: var(--s-7);
    border-top: 1px solid var(--ivory-line);
    font-size: clamp(1.75rem, 0.9rem + 3.6vw, 4.6rem);
    line-height: 1.02;
    font-weight: 450;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  /* long lines may wrap on small screens, but only between words */
  .manifesto__statement > span { white-space: normal; }
  .manifesto__indent { font-style: italic; color: var(--ink); }

  @media (min-width: 900px) {
    .manifesto__grid {
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--col-gap);
      row-gap: 0;
      align-items: start;
    }
    .manifesto__title { grid-column: 2 / 10; }
    .manifesto__body { grid-column: 10 / 13; padding-top: clamp(6rem, 11vw, 11rem); }
    .manifesto__statement {
      grid-column: 2 / 13;
      margin-top: clamp(5rem, 10vw, 10rem);
    }
    .manifesto__statement > span { white-space: nowrap; }
    .manifesto__indent { padding-left: 16.6%; }
  }
</style>
